
# ============================================
# AI Engineering System - .gitignore
# ============================================

# --------------------------------------------
# Operating Systems
# --------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.nfs*

# --------------------------------------------
# Editors / IDEs
# --------------------------------------------

.idea/
*.swp
*.swo
*.swn
*.orig

# VS Code - ignore local state, allow shared config
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# --------------------------------------------
# Environment Variables / Secrets
# --------------------------------------------

.env
.env.*
!.env.example
!.env.sample
!.env.template

.envrc
*.secret
*.secrets
*.pem
*.p12
*.pfx
*.key
credentials.json
service-account.json

# --------------------------------------------
# Logs / Temporary Files
# --------------------------------------------

*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.bak

# --------------------------------------------
# Python
# --------------------------------------------

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# --------------------------------------------
# Node.js / JavaScript / TypeScript
# --------------------------------------------

node_modules/
.npm/
.pnpm-store/
.yarn/cache/
*.tsbuildinfo

# Framework and build caches
.next/
.turbo/
.cache/

# Generated test coverage
coverage/
.nyc_output/

# --------------------------------------------
# Claude Code / AI Agent Local State
# --------------------------------------------

# Local Claude Code settings
.claude/settings.local.json

# Local runtime artifacts
.claude/projects/
.claude/todos/
.claude/debug/
.claude/telemetry/

# Aider local history/cache
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*

# Cursor local debug logs
.cursor/debug.log

# --------------------------------------------
# Testing Artifacts
# --------------------------------------------

playwright-report/
test-results/

# --------------------------------------------
# Local Databases
# --------------------------------------------

*.sqlite
*.sqlite3
*.db
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# --------------------------------------------
# Scratch / Local Workspaces
# --------------------------------------------

scratch/
sandbox/

# --------------------------------------------
# IMPORTANT: Intentionally NOT ignored
# --------------------------------------------

# SKILL.md
# CLAUDE.md
# README.md
# .claude/settings.json
# .claude/skills/
# .claude/agents/
# .claude/rules/
# .claude/hooks/
# scripts/
# references/
# examples/
# tests/
# evals/
# dist/
# build/
# *.zip
# *.tar.gz
# SHA256SUMS
